# Copy to .env and adjust. Every value here has a working default.
#
# The LLM runs locally through Ollama on your own machine, so no cloud account or
# API key is needed. Requirements on the host:
#     ollama serve          (keep it running)
#     ollama pull qwen3:8b  (the model named in services/llm-gateway/config.yaml)

POSTGRES_USER=instacram
POSTGRES_PASSWORD=instacram
POSTGRES_DB=instacram
POSTGRES_PORT=5432

QDRANT_PORT=6333

# Chosen by measurement in W3, not by reputation. At the threshold where false
# merges reach zero, each model retains this share of genuinely-identical topics:
#   intfloat/e5-base-v2                     768 dims  0.955  67%  <- chosen
#   sentence-transformers/all-MiniLM-L6-v2  384 dims  0.830  53%
#   BAAI/bge-base-en-v1.5                   768 dims  0.930  40%
# Changing the model invalidates every stored vector AND the threshold: reindex
# and re-calibrate together, never one alone.
EMBEDDING_MODEL=intfloat/e5-base-v2
EMBEDDINGS_PORT=8081

# Prefix applied to the text that represents a topic. Empty on purpose: e5's
# documented "query: " prefix was measured and made reuse WORSE (53% vs 67%).
EMBEDDING_TEXT_PREFIX=

# Above this cosine similarity, a candidate topic is treated as one we already
# have. Calibrated, not guessed - see services/serving/calibration/.
TOPIC_MATCH_THRESHOLD=0.955

LLM_GATEWAY_PORT=4000

# Where the gateway finds Ollama. host.docker.internal means "the host machine",
# as seen from inside a container. Point this elsewhere to use a remote Ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Only needed if you switch config.yaml back to a hosted provider.
GEMINI_API_KEY=

SERVING_PORT=3000
PIPELINE_PORT=8000

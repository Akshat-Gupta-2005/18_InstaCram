# Copy to .env and adjust. Every value here has a working default except
# SCRAPER_CONTACT, which has no safe default and must be filled in by hand.
#
#     cp .env.example .env
#
# ONE file, at the repo root, read by all three consumers:
#   - docker compose          automatically, for ${VAR} substitution in the compose file
#   - services/serving        via src/env.ts, which resolves the root path explicitly
#   - services/pipeline       via load_dotenv() pointed at the root path
# Node and Python both run with their service folder as the working directory, so
# neither finds a root .env by default. That is why the loaders name it, and why
# there is no second .env under either service - two copies would drift.
#
# Compose substitution and container environment are NOT the same thing: a variable
# used as ${VAR} in docker-compose.yml still has to be listed under a service's
# `environment:` before the process inside that container can read it.
#
# The LLM runs locally through Ollama on your own machine, so no cloud account or
# API key is needed. Requirements on the host:
#     ollama serve          (keep it running)
#     ollama pull qwen3:8b  (the model named in services/llm-gateway/config.yaml)

# ---------------------------------------------------------------- database
POSTGRES_USER=instacram
POSTGRES_PASSWORD=instacram
POSTGRES_DB=instacram
POSTGRES_PORT=5432

# For running serving/pipeline code on the HOST (tests, migrate, seed, calibration).
# Inside containers compose overrides this to use host `postgres`, not localhost.
DATABASE_URL=postgres://instacram:instacram@localhost:5432/instacram

# ---------------------------------------------------------------- vectors
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# Chosen by measurement in W3, not by reputation. At the threshold where false
# merges reach zero, each model retains this share of genuinely-identical topics:
#   intfloat/e5-base-v2                     768 dims  0.955  67%  <- chosen
#   sentence-transformers/all-MiniLM-L6-v2  384 dims  0.830  53%
#   BAAI/bge-base-en-v1.5                   768 dims  0.930  40%
# Changing the model invalidates every stored vector AND the threshold: reindex
# and re-calibrate together, never one alone.
EMBEDDING_MODEL=intfloat/e5-base-v2
EMBEDDINGS_PORT=8081
EMBEDDINGS_URL=http://localhost:8081

# Fixed by the model above. A Qdrant collection's vector size cannot be changed
# after creation, so this is a rebuild, not a tweak.
EMBEDDING_DIMENSIONS=768

# Prefix applied to the text that represents a topic. Empty on purpose: e5's
# documented "query: " prefix was measured and made reuse WORSE (53% vs 67%).
EMBEDDING_TEXT_PREFIX=

# Above this cosine similarity, a candidate topic is treated as one we already
# have. Calibrated, not guessed - see services/serving/calibration/.
# The margin is thin: the worst observed false positive scored 0.9542.
TOPIC_MATCH_THRESHOLD=0.955

# ---------------------------------------------------------------- llm
LLM_GATEWAY_PORT=4000
LLM_GATEWAY_URL=http://localhost:4000

# Where the gateway finds Ollama. host.docker.internal means "the host machine",
# as seen from inside a container. Point this elsewhere to use a remote Ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Only needed if you switch config.yaml back to a hosted provider.
GEMINI_API_KEY=

# ---------------------------------------------------------------- services
SERVING_PORT=3000
PIPELINE_PORT=8000

# How requests prove who they are.
#   dev        TRUSTS THE BEARER TOKEN AS THE IDENTITY - anyone can be anyone.
#              The test suite's mode. Never for a running app.
#   dev-login  log in with DEV_LOGIN_ID + DEV_LOGIN_PASSWORD at POST /v1/auth/login
#              and get a signed token. The mode for running the app locally until
#              real sign-in (Firebase: email/password + Google) exists.
#   firebase   not wired yet (task 2b.1).
# dev-login has no rate limiting: local machine only.
AUTH_MODE=dev-login

# dev-login credentials. Pick your own; the password must not be empty.
DEV_LOGIN_ID=developer
DEV_LOGIN_PASSWORD=

# Signs dev-login tokens; at least 32 characters. Anyone holding it can mint a
# token for any identity, so keep it out of git. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=168

# Browser origins allowed to call the API: the web build of the app. Port 8082,
# because Expo's default 8081 is taken by the embeddings service above.
CORS_ORIGINS=http://localhost:8082

# Placeholders, not measured values - see Docs/FEATURES.md open items.
FEED_PAGE_SIZE=10
FEED_RETRY_AFTER_MS=3000

# Where the agent prompts are read from. Unset on the host, where the repo-relative
# fallback finds them; the serving image sets it to /app/prompts.
# PROMPTS_DIR=

# ---------------------------------------------------------------- scraper
# REQUIRED BEFORE THE SCRAPER SPIKE CAN RUN - there is no safe default, so this is
# the one value you must supply yourself. Wikimedia answers clients that do not
# identify themselves with HTTP 403 and "Please respect our robot policy"; the same
# request from an identifying client returns 200. Use a REAL contact a maintainer
# can be reached at - a GitHub repo URL is the agreed form:
#   SCRAPER_CONTACT=https://github.com/<you>/<repo>
# Faking it to get past the check would be evading the policy, not following it.
SCRAPER_CONTACT=

# ---------------------------------------------------------------- calibration
# Only used by src/calibration/sweep.ts, to point a run at a throwaway model server
# and label its output file. Normally unset, so the sweep uses EMBEDDINGS_URL.
# SWEEP_URL=
# SWEEP_LABEL=
